{
  "name": "a11y-loop",
  "version": "0.3.0",
  "description": "Makes AI coding agents decide accessibility while the work is still being planned and write accessible UI by default, then proves what it can prove with a real browser audit across the states they built — and tells you exactly what it could not check.",
  "type": "module",
  "bin": {
    "a11y-loop": "src/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "test:unit": "node --test \"test/unit/*.test.js\"",
    "test:integration": "node --test \"test/integration/*.test.js\""
  },
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "axe-core",
    "playwright",
    "ai-agents",
    "agent-skills",
    "claude-code",
    "claude-code-plugin",
    "plan-mode",
    "audit",
    "contrast"
  ],
  "license": "MIT",
  "author": "Chan Meng <chanmeng.dev@gmail.com> (https://github.com/ChanMeng666)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChanMeng666/a11y-loop.git"
  },
  "homepage": "https://github.com/ChanMeng666/a11y-loop#readme",
  "bugs": {
    "url": "https://github.com/ChanMeng666/a11y-loop/issues"
  },
  "files": [
    "src/",
    "skills/",
    ".claude-plugin/",
    "hooks/",
    "commands/",
    "THIRD-PARTY-NOTICES.md"
  ],
  "dependencies": {
    "@axe-core/playwright": "4.14.0",
    "axe-core": "4.14.0",
    "culori": "^4.0.2",
    "playwright": "1.64.1",
    "tabbable": "^6.5.0"
  }
}
